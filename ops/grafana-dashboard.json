{
  "title": "Haneul oracle price service",
  "uid": "haneul-oracle",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "5s",
  "tags": [
    "haneul",
    "oracle"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      },
      {
        "name": "feed",
        "type": "query",
        "label": "Feed",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(oracle_feed_sources_used, feed)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Seconds since each feed was signed",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "time() - oracle_feed_last_signed_timestamp_seconds{feed=~\"$feed\"}",
          "legendFormat": "{{feed}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "description": "The markets stop on a feed older than their tolerance (10 s by default).",
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Seconds since an update landed on chain",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "time() - oracle_feed_last_relayed_timestamp_seconds{feed=~\"$feed\"}",
          "legendFormat": "{{feed}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Venues each feed stands on",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "oracle_feed_sources_used{feed=~\"$feed\"}",
          "legendFormat": "{{feed}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Signed price",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "oracle_feed_price{feed=~\"$feed\"}",
          "legendFormat": "{{feed}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Confidence interval",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "oracle_feed_confidence_bps{feed=~\"$feed\"}",
          "legendFormat": "{{feed}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Basis points of the price. Nothing is signed past the feed's bound (50 by default).",
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Each venue against the signed price",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "(oracle_source_mid_price{feed=~\"$feed\"} / on (feed) group_left oracle_feed_price - 1) * 10000",
          "legendFormat": "{{feed}} {{source}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Basis points. A venue that drifts from the others shows here before it is left out as an outlier.",
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Rounds a venue was left out of, by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (source, outcome) (rate(oracle_feed_source_rounds_total{feed=~\"$feed\",outcome!=\"used\"}[5m]))",
          "legendFormat": "{{source}} {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "id": 7
    },
    {
      "type": "stat",
      "title": "Streams up",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "expr": "oracle_stream_up",
          "legendFormat": "{{exchange}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Stream reconnects",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 4,
        "h": 8
      },
      "targets": [
        {
          "expr": "increase(oracle_stream_errors_total[10m])",
          "legendFormat": "{{exchange}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Quotes by how they arrived",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (transport, result) (rate(oracle_source_quotes_total[1m]))",
          "legendFormat": "{{transport}} {{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Time a round waits for the venues",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, rate(oracle_fetch_duration_seconds_bucket[5m]))",
          "legendFormat": "median",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(oracle_fetch_duration_seconds_bucket[5m]))",
          "legendFormat": "95th percentile",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Time a round takes, relay included",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, rate(oracle_round_duration_seconds_bucket[5m]))",
          "legendFormat": "median",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(oracle_round_duration_seconds_bucket[5m]))",
          "legendFormat": "95th percentile",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Age of the quote each source gave",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "oracle_source_quote_age_seconds",
          "legendFormat": "{{exchange}} {{market}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Relays",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(oracle_relays_total[1m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "id": 14
    },
    {
      "type": "timeseries",
      "title": "Rounds skipped or clamped",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 32,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "increase(oracle_feed_skipped_total{feed=~\"$feed\"}[5m])",
          "legendFormat": "{{feed}} skipped ({{reason}})",
          "refId": "A"
        },
        {
          "expr": "increase(oracle_feed_clamped_total{feed=~\"$feed\"}[5m])",
          "legendFormat": "{{feed}} clamped",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 15
    },
    {
      "type": "timeseries",
      "title": "Gas spent per day at the current rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(oracle_relay_gas_total[10m]) * 86400 / 1e9",
          "legendFormat": "HANEUL per day",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 16
    },
    {
      "type": "stat",
      "title": "Relayer balance",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 32,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "oracle_relayer_balance_haneul",
          "legendFormat": "HANEUL",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 17
    }
  ]
}
